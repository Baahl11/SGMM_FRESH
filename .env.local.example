# Variables de Entorno para Sistema de Mensajería en Producción

# ============================================
# WhatsApp Business API Configuration
# ============================================
# Obtener desde: https://developers.facebook.com/apps/
WHATSAPP_API_KEY=your_whatsapp_business_api_key_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# ============================================
# SendGrid Email Configuration
# ============================================
# Obtener desde: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@tu-clinica.com

# ============================================
# Database Configuration (Futuro)
# ============================================
# DATABASE_URL=your_database_url_for_message_logs

# ============================================
# Cron Job Authentication (Opcional)
# ============================================
# CRON_SECRET=your_secret_key_for_cron_jobs

# ============================================
# Development/Testing Flags
# ============================================
# Forzar modo demo incluso con credenciales configuradas
# FORCE_DEMO_MODE=true

# Habilitar logs detallados
# DEBUG_MESSAGING=true
