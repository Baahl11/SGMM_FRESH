# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
src-tauri/.env

# Keep .env.example for documentation
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python virtual environment
.venv/
venv/
backend/new_venv/
backend/venv/
backend/python/

# Python cache and bytecode
__pycache__/
*.py[cod]
backend/__pycache__/

# Logs
*.log
backend_debug.log

# Database (no versionar la DB en desarrollo)
consultorio.db
consultorio_old.db
/data/
*.db

# Other common ignores
*.log

# Rust/Cargo build files  
target/
tools/license-generator/target/

# Temporary files and uploads
uploads/
sgmm-minimal-bundle.zip
sgmm-scan-report.md
scan_sgmm.py
