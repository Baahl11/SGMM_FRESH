      const data = await response.json();
      return { data };
    } catch (error) {
      return { error: error instanceof Error ? error.message : "Unknown error" };
    }
  }

  static async updateImageComment(patientId: number, imageName: string, comment: string): Promise<ApiResponse<any>> {
