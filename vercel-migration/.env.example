# ========================================
# SUPABASE
# ========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ========================================
# NEXTAUTH (NextAuth.js)
# ========================================
# Genera un secret con: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
# En producción: NEXTAUTH_URL=https://agendamedpro.com

# ========================================
# GOOGLE OAUTH (para login con Google)
# ========================================
# Obtén estas credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ========================================
# STRIPE (para suscripciones)
# ========================================
# Obtén estas keys en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Webhook secret (obtén en: https://dashboard.stripe.com/test/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ========================================
# STRIPE PRICE IDs (Plans)
# ========================================
# Plan Básico
NEXT_PUBLIC_STRIPE_PRICE_BASICO_MONTHLY=price_xxx_basico_monthly
NEXT_PUBLIC_STRIPE_PRICE_BASICO_ANNUAL=price_xxx_basico_annual

# Plan Pro
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_xxx_pro_monthly
NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=price_xxx_pro_annual

# Plan Enterprise
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx_enterprise_monthly
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxx_enterprise_annual

# Plan Lifetime (pago único)
NEXT_PUBLIC_STRIPE_PRICE_LIFETIME=price_xxx_lifetime

# ========================================
# SITE CONFIG
# ========================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En producción: NEXT_PUBLIC_SITE_URL=https://agendamedpro.com

# ========================================
# TWILIO (para WhatsApp/SMS - opcional)
# ========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ========================================
# CRON SECRET (para endpoints de cron protegidos)
# ========================================
CRON_SECRET=your_random_secret_key_here
