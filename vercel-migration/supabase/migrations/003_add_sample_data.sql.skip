-- Add sample appointments data
INSERT INTO appointments (patient_id, treatment_id, fecha_hora, duracion_minutos, estado, notas, precio_acordado) 
SELECT 
  p.id as patient_id,
  t.id as treatment_id,
  CASE 
    WHEN ROW_NUMBER() OVER() = 1 THEN NOW() + INTERVAL '2 hours'
    WHEN ROW_NUMBER() OVER() = 2 THEN NOW() + INTERVAL '1 day'
    WHEN ROW_NUMBER() OVER() = 3 THEN NOW() + INTERVAL '2 days'
    ELSE NOW() + INTERVAL '3 days'
  END as fecha_hora,
  t.duracion_minutos,
  CASE 
    WHEN ROW_NUMBER() OVER() % 3 = 0 THEN 'completada'
    WHEN ROW_NUMBER() OVER() % 3 = 1 THEN 'confirmada'
    ELSE 'programada'
  END as estado,
  'Cita de ejemplo generada automáticamente' as notas,
  t.precio_base as precio_acordado
FROM (
  SELECT id, nombre, apellido FROM patients LIMIT 2
) p
CROSS JOIN (
  SELECT id, nombre, descripcion, precio_base, duracion_minutos FROM treatments LIMIT 2
) t
LIMIT 4;

