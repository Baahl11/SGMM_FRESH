{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "next dev",
  "alias": ["agendamedpro.com", "www.agendamedpro.com"],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/whatsapp-reminders",
      "schedule": "0 * * * *"
    }
  ]
}