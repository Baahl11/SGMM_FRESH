{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm install --legacy-peer-deps --include=dev",
  "devCommand": "next dev",
  "alias": ["agendamedpro.com", "www.agendamedpro.com"],
  "headers": [
    {
      "source": "/auth/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/agents/reminders/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/trial-reminders",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/onboarding-drip",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/messaging-worker",
      "schedule": "* * * * *"
    }
  ]
}