# SGMM Pro - Environment Variables Example
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL="file:./sgmm.db"

# FastAPI Backend
NEXT_PUBLIC_API_URL=http://localhost:8000
FASTAPI_PORT=8000

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here
AUTH_SECRET=your-nextauth-secret-here

# Google OAuth (Get from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# Facturama API
FACTURAMA_SANDBOX_URL=https://apisandbox.facturama.mx
FACTURAMA_USER=your-facturama-user
FACTURAMA_PASSWORD=your-facturama-password

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Logging
NEXT_PUBLIC_DEBUG_API=false
